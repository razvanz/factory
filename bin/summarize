#!/usr/bin/env bash
# Fails the run when an expected stage recorded no result, or recorded failed or blocked.
# Writes the stage table to the step summary and, when REPORT_FILE is set, to that file.
# Usage: summarize '<toJSON(needs)>' stage1 stage2 ...
set -euo pipefail

needs=${1:?needs json}
shift

bad=0
table=$'| Stage | Status | Reason |\n|---|---|---|'
for stage in "$@"; do
  result=$(jq -r --arg s "$stage" '.[$s].outputs.result // empty' <<<"$needs")
  if [[ -z "$result" ]]; then
    job=$(jq -r --arg s "$stage" '.[$s].result // "absent"' <<<"$needs")
    status=missing
    reason="no result recorded (job $job)"
  else
    status=$(jq -r .status <<<"$result")
    reason=$(jq -r .reason <<<"$result")
  fi
  table+=$'\n'"| $stage | $status | ${reason//|/\\|} |"
  case "$status" in done|skipped) ;; *) bad=1 ;; esac
done

printf '## Factory run\n\n%s\n' "$table" >> "${GITHUB_STEP_SUMMARY:-/dev/stdout}"
[[ -z "${REPORT_FILE:-}" ]] || printf '%s\n' "$table" > "$REPORT_FILE"

exit "$bad"
